{
  "name": "dsh-workbench-personal-social-local",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "小红书、抖音、哔哩哔哩、X，一个看板查看账号与作品。支持定时同步、每日趋势和本地历史记录，可扩展更多平台。",
  "author": "本机用户",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beianbai/cross-platform-account-dashboard"
  },
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib/client.js",
    "lib/browser-extension",
    "lib/browser-connector.zip",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs/USAGE.md",
    "docs/DSH-LOCAL-DEVELOPMENT.md",
    "docs/PLATFORM-DEVELOPMENT.md",
    "LICENSE",
    "standalone",
    "CHANGELOG.md",
    "src",
    "assets",
    "scripts/build.mjs",
    "scripts/build-standalone.mjs",
    "scripts/zip.mjs",
    "extension",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "scripts/check-workbench-package.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs && node scripts/build-standalone.mjs",
    "check": "node scripts/check-workbench-package.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "prestart": "npm run build",
    "start": "node standalone/server.mjs",
    "auth:code": "node standalone/auth-cli.mjs code",
    "auth:reset": "node standalone/auth-cli.mjs reset"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "packageManager": "pnpm@10.34.5"
}
